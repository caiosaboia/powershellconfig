# ==============================================================================
# Noctty Terminal Emulator Configuration (Ghostty Native for Windows)
# Theme: Catppuccin Mocha
# ==============================================================================

# Configuracoes visuais e fontes
font-family = MesloLGS Nerd Font
font-size = 10
theme = Catppuccin Mocha
background-opacity = 1
window-padding-x = 8
window-padding-y = 6
working-directory = home
copy-on-select = clipboard

# Shell padrao
command = C:\Program Files\PowerShell\7\pwsh.exe

# ------------------------------------------------------------------------------
# Notificacoes e Integracao com Sistema / PSMux
# ------------------------------------------------------------------------------
# Ativa som de notificacao do Windows, destaque (flash) na barra de tarefas e
# icone de sino no titulo quando processos ou o psmux emitirem sinal de atencao.
bell-features = system,attention,title
desktop-notifications = true

# ------------------------------------------------------------------------------
# Atalhos de Divisao de Tela (Splits)
# ------------------------------------------------------------------------------
# Criacao de splits (Horizontal e Vertical)
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+o=new_split:right
keybind = alt+shift+d=new_split:auto
keybind = alt+shift+-=new_split:down
keybind = alt+shift++=new_split:right

# Fechamento de splits (fecha apenas o split atual / surface)
keybind = ctrl+shift+w=close_surface
keybind = alt+shift+w=close_surface

# Navegacao entre splits (Setas e Estilo Vim h/j/k/l)
keybind = alt+arrow_left=goto_split:left
keybind = alt+arrow_down=goto_split:down
keybind = alt+arrow_up=goto_split:up
keybind = alt+arrow_right=goto_split:right
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right
keybind = alt+]=goto_split:next
keybind = alt+[=goto_split:previous

# Redimensionamento de splits
keybind = alt+shift+arrow_left=resize_split:left,10
keybind = alt+shift+arrow_down=resize_split:down,10
keybind = alt+shift+arrow_up=resize_split:up,10
keybind = alt+shift+arrow_right=resize_split:right,10
keybind = alt+shift+h=resize_split:left,10
keybind = alt+shift+j=resize_split:down,10
keybind = alt+shift+k=resize_split:up,10
keybind = alt+shift+l=resize_split:right,10

# Equalizacao e Zoom de splits
keybind = alt+==equalize_splits
keybind = ctrl+shift+enter=toggle_split_zoom
keybind = alt+z=toggle_split_zoom
